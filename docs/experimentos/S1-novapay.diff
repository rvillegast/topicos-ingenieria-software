--- /dev/null
+++ b/flownow/src/modules/payment/adapters/novapay/index.js
@@ -0,0 +1,15 @@
+// Adapter de NovaPay (proveedor ficticio del experimento S1). Mismo puerto que stripey/payfast.
+const config = require('../../../../platform/config');
+const helpers = require('../../../../utils/helpers');
+const { ProviderError } = require('../../providers/errors');
+
+exports.name = 'novapay';
+
+exports.charge = async ({ amount, currency, token }) => {
+  try {
+    await helpers.httpPost(config.providers.novapay.chargeUrl, { amount, currency, token });
+  } catch (e) { throw new ProviderError(e && e.message ? e.message : 'error del proveedor', { cause: e }); }
+  return { status: 'captured', providerRef: 'np_' + Date.now(), providerStatus: 'approved' };
+};
+exports.refund = async () => ({ ok: true });
+exports.parseWebhook = () => null;
